#pragma once

// Copy to secrets.h and fill in your values. secrets.h is gitignored.

#define WIFI_SSID "your-wifi-ssid"
#define WIFI_PASS "your-wifi-password"

// A .local name survives the broker changing IP or router; the server must use this hostname.
#define MQTT_HOST       "homeserver.local"
#define MQTT_PORT       1883
#define MQTT_CLIENT_ID  "monotub"

// Password for Wi-Fi flashing. Leave the placeholder: the first build replaces it
// with a random one and prints it once (scripts/ota_password.py).
#define OTA_PASSWORD    "choose-an-ota-password"
